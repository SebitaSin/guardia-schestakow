# Servidor privado. Copiar sólo al entorno del servidor; no guardar secretos en Git.
APP_ROOT=C:\ruta\schestakow-libre
APP_DATA_DIR=C:\ruta\schestakow-data
APP_USERS_FILE=C:\ruta\segura\users.local.json
APP_SESSION_SECRET=
APP_COOKIE_SECURE=true
APP_HOST=127.0.0.1
APP_PORT=8788

# Google Maps + Routes. En Replit/Netlify crear exactamente estos dos Secrets.
# Pueden contener la misma clave "Guardia Maps y Rutas" con las restricciones adecuadas.
GOOGLE_MAPS_API_KEY=
GOOGLE_ROUTES_API_KEY=

# Gmail IMAP de sólo lectura
GMAIL_SYNC_ENABLED=false
HOSPITAL_IMAP_ACCOUNT=
HOSPITAL_IMAP_PASSWORD=
GMAIL_SYNC_HOURS=24

# Laboratorio opcional. Salida privada en APP_DATA_DIR; nunca se incluye en el bundle.
LAB_BASE_URL=
LAB_LOGIN=
LAB_PASSWORD=

# WhatsApp Business / Cloud API. Nunca se envían al navegador.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GROUP_ID=
WHATSAPP_GRAPH_VERSION=

# IA opcional. Apagada hasta validar privacidad, modelo, presupuesto y caso de uso.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
AI_MONTHLY_BUDGET_USD=0
AI_MONTHLY_CALL_LIMIT=0
AI_INPUT_USD_PER_MILLION=0
AI_OUTPUT_USD_PER_MILLION=0
AI_ALLOW_CLINICAL_DATA=false
